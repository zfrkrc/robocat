# /etc/robocat/server.env  (chmod 600)
ROBO_DATA_DIR=/var/lib/robocat
ROBO_DETECTOR=motion
ROBO_TRUST_PROXY=1
ROBO_CORS_ORIGINS=https://esp32.zk.net.tr
# cihaz başına anahtar: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ROBO_DEVICE_KEYS=robocat-1:CHANGE_ME
ROBO_DEVICE_ROBOTS=robocat-1:robocat-1
ROBO_DEVICE_POLL_S=2
ROBO_DEVICE_MIN_INTERVAL_S=0.4

# --- radyo testi (attack) — varsayılan KAPALI -------------------------
ROBO_ATTACK_ENABLE=0
# yalnız kendi BSSID'lerin (küçük harf, virgülle)
ROBO_ATTACK_BSSIDS=
ROBO_ATTACK_MAX_S=60
ROBO_ATTACK_COOLDOWN_S=15
ROBO_ATTACK_DAILY_MAX=10
ROBO_ATTACK_ARM_TTL_S=120
# cihaz yerel UI adresi (nearby/scan proxy icin)
ROBO_DEVICE_URLS=pentest-1:http://172.16.16.221
